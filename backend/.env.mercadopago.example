# Copia este archivo como backend/.env y reemplaza los valores de prueba.
# Nunca publiques backend/.env ni compartas sus secretos.

# Credenciales TEST de la aplicación Mercado Pago.
MERCADO_PAGO_ENABLED=true
MERCADO_PAGO_ACCESS_TOKEN_ENV=MERCADO_PAGO_ACCESS_TOKEN
MERCADO_PAGO_WEBHOOK_SECRET_ENV=MERCADO_PAGO_WEBHOOK_SECRET
MERCADO_PAGO_ACCESS_TOKEN=TEST-REEMPLAZAR_CON_ACCESS_TOKEN_DE_PRUEBA
MERCADO_PAGO_WEBHOOK_SECRET=REEMPLAZAR_CON_CLAVE_SECRETA_DEL_WEBHOOK

# API oficial. No cambiar para la prueba sandbox.
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_HTTP_TIMEOUT=15
MERCADO_PAGO_USE_SANDBOX_INIT_POINT=false
MERCADO_PAGO_ACCEPT_LIVE_MODE=false

# Usa una URL HTTPS pública para Angular y otra para Django.
# FRONTEND_TUNNEL es el túnel que expone el puerto 4200.
# BACKEND_TUNNEL es el túnel que expone el puerto 8000.
MERCADO_PAGO_RETURN_BASE_URL=https://FRONTEND_TUNNEL.ngrok-free.app
MERCADO_PAGO_WEBHOOK_URL=https://BACKEND_TUNNEL.ngrok-free.app/api/portal/payments/mercado-pago/webhook/

# El túnel de Django recibe el webhook; el de Angular recibe el retorno.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,BACKEND_TUNNEL.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://FRONTEND_TUNNEL.ngrok-free.app
